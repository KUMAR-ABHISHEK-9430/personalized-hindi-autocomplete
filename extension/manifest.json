{
  "manifest_version": 3,
  "name": "Hindi Autocomplete",
  "version": "1.0.0",
  "description": "Provides Hindi autocomplete suggestions using a local AI model.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://docs.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

 "content_scripts": [
  {
    "matches": [
      "https://docs.google.com/document/*"
    ],
    "js": [
      "inject.js"
    ],
    "run_at": "document_start",
    "world": "MAIN"
  },
  {
    "matches": [
      "https://docs.google.com/document/*"
    ],
    "js": [
      "overlay.js",
      "content.js"
    ],
    "run_at": "document_idle"
  }
],

  "action": {
    "default_title": "Hindi Autocomplete"
  }
}